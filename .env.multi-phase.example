# ============================================================================
# MULTI-PHASE REGISTRATION SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# EMAIL CONFIGURATION - Choose ONE option below
# ============================================================================

# OPTION 1: RESEND (Recommended for Production)
# ============================================================================
VITE_USE_RESEND_EMAIL=true
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_FROM_EMAIL=noreply@yourcompany.com
VITE_ADMIN_EMAIL=admin@yourcompany.com

# OPTION 2: GMAIL SMTP with Nodemailer (Development)
# ============================================================================
# VITE_USE_RESEND_EMAIL=false
# VITE_EMAIL_USER=your-email@gmail.com
# VITE_EMAIL_PASSWORD=your-app-password
# VITE_FROM_EMAIL=your-email@gmail.com
# VITE_ADMIN_EMAIL=admin@yourcompany.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
VITE_APP_NAME=SARJANA HR-TECH
VITE_APP_VERSION=1.0.0
VITE_APP_URL=http://localhost:8000
VITE_ADMIN_PANEL_URL=http://localhost:8000/admin

# ============================================================================
# ACCESS CODE CONFIGURATION
# ============================================================================
# Default values - can be overridden in code if needed
ACCESS_CODE_EXPIRY_DAYS=90
ACCESS_CODE_MAX_USES=unlimited

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Supabase Storage bucket names
VITE_STORAGE_BUCKET_COMPANY_DOCS=company_documents

# ============================================================================
# NOTES
# ============================================================================
# 1. For Resend:
#    - Sign up at https://resend.com
#    - Get API key from dashboard
#    - Verify your sending domain
#
# 2. For Gmail:
#    - Enable 2FA on your Gmail account
#    - Generate App Password: https://myaccount.google.com/apppasswords
#    - Use the 16-character app password (spaces are removed)
#    - Do NOT use your regular Gmail password
#
# 3. Supabase:
#    - Go to Project Settings → API
#    - Copy the Project URL and Anon Key
#    - Never expose the Service Role Key in frontend
#
# 4. Admin Email:
#    - Should receive all company registration notifications
#    - Make sure this address is monitored
#
# 5. For local development:
#    - Use http://localhost:8000 for VITE_APP_URL
#    - Use http://localhost:8000/admin for VITE_ADMIN_PANEL_URL
#
# 6. For production:
#    - Replace with your actual domain (https://yourcompany.com)
#    - Use environment variables from CI/CD pipeline
#    - Never commit real secrets to git
